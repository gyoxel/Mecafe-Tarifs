# ── Accès à l'application ───────────────────────────────────────────
# Mot de passe partagé par les commerciaux (lecture du catalogue + prix commerciaux)
APP_PASSWORD=
# Mot de passe administrateur (modifier les prix commerciaux, /admin)
ADMIN_PASSWORD=
# Secret de signature des sessions : 32 caractères minimum. Génération : openssl rand -base64 48
SESSION_SECRET=

# ── Shopify (Storefront API, appelée UNIQUEMENT côté serveur) ───────
# Sans ces variables, l'application tourne avec un catalogue de démonstration.
SHOPIFY_STORE_DOMAIN=votre-boutique.myshopify.com
# Token Storefront (privé de préférence : commence par shpat_)
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_API_VERSION=2026-07
# (optionnel) secret du webhook Shopify products/* pour rafraîchir le cache instantanément
SHOPIFY_WEBHOOK_SECRET=

# ── Base de données Postgres (prix commerciaux) ─────────────────────
# Fournie automatiquement par l'intégration Neon/Supabase de Vercel.
# Sans elle : stockage en mémoire, NON persistant (démo uniquement).
DATABASE_URL=
